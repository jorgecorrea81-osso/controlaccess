# MongoDB Atlas
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/controlaccesos?retryWrites=true&w=majority

# Server (API + Socket.IO) — desplegar fuera de Vercel (Render/Railway/Fly)
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRES_IN=7d

# Frontend en Vercel (ej. https://controlaccesos.vercel.app)
CLIENT_URL=http://localhost:5173

# Orígenes CORS: lista separada por comas, o * para permitir todos (móvil + web)
# Ejemplo prod: https://controlaccesos.vercel.app,https://www.tudominio.com
CORS_ORIGINS=*

SOCKET_PATH=/socket.io
